<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wxy.zzarental.web.admin.mapper.FeeKeyMapper">

    <resultMap id="FeeKeyRespVOMap" type="com.wxy.zzarental.web.admin.vo.fee.FeeKeyRespVO">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <collection property="feeValueList" ofType="com.wxy.zzarental.web.admin.vo.fee.FeeValueRespVO">
            <id property="id" column="vId" />
            <result property="name" column="vName" />
            <result property="feeKeyId" column="fee_key_id" />
            <result property="unit" column="unit" />
        </collection>
    </resultMap>
    <select id="selectList" resultMap="FeeKeyRespVOMap">
        select k.id,k.name,v.id as vId,v.name as vName,v.fee_key_id,v.unit from fee_key k
        left join fee_value v on k.id = v.fee_key_id and v.is_deleted = 0
        where k.is_deleted = 0
    </select>
</mapper>
